# ALOCA+ QA System - Production Environment Configuration

# Database
DATABASE_URL=sqlite:///./aloca_qa.db
# For localhost testing, use: DATABASE_URL=sqlite:///./aloca_qa.db
# For PostgreSQL production: DATABASE_URL=postgresql://user:password@db-host:5432/aloca_qa

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Environment
ENVIRONMENT=production

# Frontend API URL (update to your production domain)
REACT_APP_API_URL=http://localhost:8000
# For production: REACT_APP_API_URL=https://api.yourdomain.com

# Logging
LOG_LEVEL=INFO

# CORS Settings - RESTRICT FOR PRODUCTION
CORS_ORIGINS=["http://localhost:3000"]
# For production: CORS_ORIGINS=["https://yourdomain.com"]

# Security
SECRET_KEY=your-production-secret-key-change-this
SECURE_COOKIES=true
HTTPS_ONLY=true
