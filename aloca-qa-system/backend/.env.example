# ALOCA+ QA System - Backend Configuration

# Database URL
# SQLite (default, for development)
DATABASE_URL=sqlite:///./aloca_qa.db

# For PostgreSQL (uncomment and update for production)
# DATABASE_URL=postgresql://user:password@localhost/aloca_qa

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Environment
ENVIRONMENT=development
# ENVIRONMENT=production

# Logging
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG

# CORS Settings (for production, restrict these)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Session/Security
SECRET_KEY=your-secret-key-change-in-production

# Apify MCP integration
APIFY_API_TOKEN=
MCP_SERVER_URL=https://mcp.apify.com
